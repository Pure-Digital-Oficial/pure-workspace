generator client {
  provider        = "prisma-client-js"
  output          = "../generated/general"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_GENERAL_URL")
  schemas  = ["pure_general", "pure_marketing", "pure-finance", "pure_c"]
}

model application {
  id         String    @id @default(uuid())
  name       String
  status     Status    @default(ACTIVE)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  users application_x_user[]

  @@schema("pure_general")
}

model application_x_user {
  app_id     String
  user_id    String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  user user        @relation(fields: [user_id], references: [id])
  app  application @relation(fields: [app_id], references: [id])

  @@id([user_id, app_id])
  @@schema("pure_general")
}

model auth {
  id           String   @id @default(uuid())
  user_id      String   @unique
  email        String
  password     String?
  access_token String?
  type         AuthType @default(DEFAULT)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())
  users        user     @relation(fields: [user_id], references: [id])

  @@schema("pure_general")
}

model user {
  id         String    @id @default(uuid())
  name       String
  nickname   String
  status     Status    @default(PENDING)
  type       UserType  @default(DEFAULT)
  picture    String?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  auth                  auth[]
  applications          application_x_user[]
  deleted               confirm_delete_user[]
  data                  user_data[]
  contacts              contact_x_user[]
  triggers              trigger[]
  shots                 shot[]
  shots_models          shot_model[]
  target_references     target_reference[]
  fixed_gains           fixed_gain[]
  category_transactions category_transaction[]
  budgets               budget[]
  transactions          transaction[]
  category_x_budgets    category_x_budget[]

  @@schema("pure_general")
}

model confirm_delete_user {
  id               String   @id @default(uuid())
  responsibly_user String
  user_id          String
  description      String
  created_at       DateTime @default(now())
  user             user     @relation(fields: [user_id], references: [id])

  @@schema("pure_general")
}

model user_data {
  id         String    @id @default(uuid())
  user_id    String    @unique
  document   String
  birth_date DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  user       user      @relation(fields: [user_id], references: [id])

  @@schema("pure_general")
}

model contact_x_user {
  contact_id String
  user_id    String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  user    user    @relation(fields: [user_id], references: [id])
  contact contact @relation(fields: [contact_id], references: [id])

  @@id([user_id, contact_id])
  @@schema("pure_general")
}

model contact {
  id        String @id @default(uuid())
  area_code String
  number    String

  status     Status    @default(ACTIVE)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  users contact_x_user[]

  @@schema("pure_general")
}

model trigger {
  id          String @id @default(uuid())
  name        String
  content     String
  description String

  user_id    String
  type       TriggerType
  status     Status      @default(ACTIVE)
  created_at DateTime    @default(now())
  updated_at DateTime?
  deleted_at DateTime?

  user               user               @relation(fields: [user_id], references: [id])
  targets_references target_reference[]

  @@schema("pure_marketing")
}

model target_reference {
  id      String @id @default(uuid())
  content String

  user_id         String
  trigger_id      String
  local_id        String?
  status          Status         @default(ACTIVE)
  internal_status InternalStatus @default(ON_HOLD)
  created_at      DateTime       @default(now())
  updated_at      DateTime?
  deleted_at      DateTime?

  trigger trigger        @relation(fields: [trigger_id], references: [id])
  user    user           @relation(fields: [user_id], references: [id])
  history history_shot[]

  @@schema("pure_marketing")
}

model shot {
  id            String    @id @default(uuid())
  title         String
  scheduled     Boolean
  schedule_date DateTime?

  model_id        String
  user_id         String
  status          Status         @default(ACTIVE)
  internal_status InternalStatus @default(ON_HOLD)
  created_at      DateTime       @default(now())
  updated_at      DateTime?
  deleted_at      DateTime?

  user    user           @relation(fields: [user_id], references: [id])
  model   shot_model     @relation(fields: [model_id], references: [id])
  history history_shot[]

  @@schema("pure_marketing")
}

model shot_model {
  id      String @id @default(uuid())
  title   String
  subject String
  body    String
  image   String

  user_id    String
  status     Status    @default(ACTIVE)
  created_at DateTime  @default(now())
  updated_at DateTime?
  deleted_at DateTime?

  user  user   @relation(fields: [user_id], references: [id])
  shots shot[]

  @@schema("pure_marketing")
}

model history_shot {
  id              String  @id @default(uuid())
  error           String?
  target_id       String
  shot_id         String
  oppened         Boolean @default(false)
  clicked_in_link Boolean @default(false)

  created_at DateTime
  updated_at DateTime?
  clicked_at DateTime?
  oppened_at DateTime?
  shoted_at  DateTime?
  status     InternalStatus @default(PROCESSING)

  target target_reference @relation(fields: [target_id], references: [id])
  shot   shot             @relation(fields: [shot_id], references: [id])

  @@schema("pure_marketing")
}

model fixed_gain {
  id             String    @id @default(uuid())
  name           String
  value          Float
  status         Status    @default(ACTIVE)
  day_of_receipt Int
  frequency      Frequency
  user_id        String
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())
  deleted_at     DateTime?

  user user @relation(fields: [user_id], references: [id])

  @@schema("pure-finance")
}

model transaction {
  id           String          @id @default(uuid())
  name         String
  value        Float
  type         TransactionType
  status       Status          @default(ACTIVE)
  user_id      String
  category_id  String
  initial_date DateTime?
  final_date   DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user     user                 @relation(fields: [user_id], references: [id])
  category category_transaction @relation(fields: [category_id], references: [id])

  @@schema("pure-finance")
}

model category_transaction {
  id          String @id @default(uuid())
  name        String
  description String
  status      Status @default(ACTIVE)
  user_id     String

  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user              user                @relation(fields: [user_id], references: [id])
  transactions      transaction[]
  category_x_budget category_x_budget[]

  @@schema("pure-finance")
}

model category_x_budget {
  category_id String
  budget_id   String
  created_by  String

  created_at DateTime @default(now())

  user     user                 @relation(fields: [created_by], references: [id])
  category category_transaction @relation(fields: [category_id], references: [id])
  budget   budget               @relation(fields: [budget_id], references: [id])

  @@id([category_id, budget_id])
  @@schema("pure-finance")
}

model budget {
  id          String @id @default(uuid())
  name        String
  description String
  status      Status @default(ACTIVE)
  user_id     String
  limit_value Float

  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user              user                @relation(fields: [user_id], references: [id])
  category_x_budget category_x_budget[]

  @@schema("pure-finance")
}

model access_history {
  id         String    @id @default(uuid())
  client_id  String
  action    String

  created_at DateTime  @default(now())
  client client @relation(fields: [client_id], references: [id])

  @@schema("pure_c")
}

model payment_history {
  id         String    @id @default(uuid())
  client_id  String
  amount     Float
  character_id String
  plan_id String

  created_at DateTime  @default(now())

  client client @relation(fields: [client_id], references: [id])
  plan plan @relation(fields: [plan_id], references: [id])
  character character @relation(fields: [character_id], references: [id])

  @@schema("pure_c")
}

model plan_x_payment_method {
  plan_id           String
  payment_method_id String

  created_at DateTime @default(now())

  plan           plan           @relation(fields: [plan_id], references: [id])
  payment_method payment_method @relation(fields: [payment_method_id], references: [id])

  @@id([plan_id, payment_method_id])
  @@schema("pure_c")
}

model payment_plataform_x_payment_method {
  plataform_id      String
  payment_method_id String

  created_at DateTime @default(now())

  plataform      payment_plataform @relation(fields: [plataform_id], references: [id])
  payment_method payment_method     @relation(fields: [payment_method_id], references: [id])

  @@id([plataform_id, payment_method_id])
  @@schema("pure_c")
}

model character_x_plan {
  character_id String
  plan_id      String

  created_at DateTime @default(now())

  character character @relation(fields: [character_id], references: [id])
  plan      plan      @relation(fields: [plan_id], references: [id])

  @@id([character_id, plan_id])
  @@schema("pure_c")
}

model client {
  id         String    @id @default(uuid())
  name       String
  external_id      String    @unique
  language   String
  client_status StatusClient @default(STARTED)
  frequency_payment  Frequency

  status     Status    @default(ACTIVE)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  access_histories access_history[]
  payment_histories payment_history[]

  @@schema("pure_c")
}

model plan {
  id         String    @id @default(uuid())
  title     String
  description String
  amount     Float
  frequency  Frequency

  status     Status    @default(ACTIVE)
  created_at DateTime  @default(now())
  deleted_at DateTime?

  payment_histories payment_history[]
  plan_x_payment_method plan_x_payment_method[]
  character_x_plans character_x_plan[]

  @@schema("pure_c")
}

model character {
  id         String    @id @default(uuid())
  name       String
  description String

  status     Status    @default(ACTIVE)
  created_at DateTime  @default(now())
  deleted_at DateTime?

  payment_histories payment_history[]
  character_x_plans character_x_plan[]

  @@schema("pure_c")
}

model payment_method {
  id         String    @id @default(uuid())
  title       String
  description String

  status     Status    @default(ACTIVE)
  created_at DateTime  @default(now())
  deleted_at DateTime?

  plan_x_payment_method plan_x_payment_method[]
  payment_plataform_x_payment_method payment_plataform_x_payment_method[]

  @@schema("pure_c")
}

model payment_plataform {
  id         String    @id @default(uuid())
  title       String
  description String
  nationality   String
  key          String
  secret_key     String

  status     Status    @default(ACTIVE)
  created_at DateTime  @default(now())
  deleted_at DateTime?

  payment_plataform_x_payment_method payment_plataform_x_payment_method[]

  @@schema("pure_c")
}

enum StatusClient {
  PAID
  STARTED
  VIEWED
  TALKED

  @@schema("pure_c")
}

enum Status {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING

  @@schema("pure_general")
}

enum AuthType {
  GOOGLE
  DEFAULT

  @@schema("pure_general")
}

enum UserType {
  DEFAULT
  DEFAULT_ADMIN
  ADMIN
  SYSTEM

  @@schema("pure_general")
}

enum TriggerType {
  EMAIL
  PHONE

  @@schema("pure_marketing")
}

enum InternalStatus {
  ERROR
  ON_HOLD
  PROCESSING
  SCHEDULED
  COMPLETE

  @@schema("pure_marketing")
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY

  @@schema("pure-finance")
}

enum TransactionType {
  WITHDRAW
  DEPOSIT

  @@schema("pure-finance")
}
